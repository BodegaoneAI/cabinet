{
  "name": "cabinet",
  "version": "0.2.11",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,daemon -c cyan,yellow \"npm run dev:next\" \"npm run dev:daemon\"",
    "dev:next": "next dev --port 3100",
    "dev:daemon": "tsx server/cabinet-daemon.ts",
    "dev:all": "concurrently -n next,daemon -c cyan,yellow \"npm run dev:next\" \"npm run dev:daemon\"",
    "debug:chrome": "bash scripts/launch-chrome-debug.sh",
    "build": "next build",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "start": "concurrently -n next,daemon -c cyan,yellow \"npm run start:next\" \"npm run start:daemon\"",
    "start:next": "next start --port 3100",
    "start:daemon": "tsx server/cabinet-daemon.ts",
    "lint": "eslint",
    "test:unit": "tsx --test test/update-system.test.ts",
    "test": "tsx --test src/lib/agents/**/*.test.ts",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-code-block-lowlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-task-item": "^3.20.4",
    "@tiptap/extension-task-list": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.1",
    "jspdf": "^4.2.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shadcn": "^4.1.0",
    "simple-git": "^3.33.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "ws": "^8.19.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
